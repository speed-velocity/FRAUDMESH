APP_ENV=dev
DATABASE_URL=sqlite:///data/runtime/fraudmesh.db
DATA_DIR=data/demo
JWT_SECRET=change-me-generate-a-long-random-value
TOKEN_KEY_ID=fraudmesh-local-1
TOKEN_ISSUER=fraudmesh
TOKEN_AUDIENCE=fraudmesh-api
SESSION_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MIN=5
DEMO_INVESTIGATOR_USER=investigator
DEMO_INVESTIGATOR_PASSWORD=replace-with-12-character-password
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASSWORD=replace-with-12-character-password
NEMOTRON_BASE_URL=
NEMOTRON_API_KEY=
NEMOTRON_MODEL=
NEMOTRON_TIMEOUT_S=90
NEMOTRON_MAX_TOKENS=2048
NEMOTRON_TEMPERATURE=0.1
NEMOTRON_MAX_JOBS_PER_MIN=10
REASONING_MODE=live
REASONING_MAX_PARALLEL=2
MAX_CONTEXT_TOKENS=24000
MAX_NARRATIVE_CHARS=8000
INGEST_STRICT=true
