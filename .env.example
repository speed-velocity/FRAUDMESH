APP_ENV=dev
DATABASE_URL=sqlite:///data/runtime/fraudmesh.db
DATA_DIR=data/demo
JWT_SECRET=change-me-generate-a-long-random-value
TOKEN_KEY_ID=fraudmesh-local-1
TOKEN_ISSUER=fraudmesh
TOKEN_AUDIENCE=fraudmesh-api
SESSION_MINUTES=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
EXPENSIVE_RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=1000000
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MIN=5
DEMO_INVESTIGATOR_USER=investigator
DEMO_INVESTIGATOR_PASSWORD=replace-with-12-character-password
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASSWORD=replace-with-12-character-password
# Nebius Token Factory is OpenAI-compatible. Keep the key backend-only.
NEMOTRON_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEMOTRON_API_KEY=replace-with-nebius-token-factory-key
# Confirm availability in your Token Factory model catalog before deploying.
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_TIMEOUT_S=90
NEMOTRON_MAX_TOKENS=2048
NEMOTRON_TEMPERATURE=0.1
NEMOTRON_MAX_JOBS_PER_MIN=10
REASONING_MODE=live
REASONING_MAX_PARALLEL=2
MAX_CONTEXT_TOKENS=24000
MAX_NARRATIVE_CHARS=8000
INGEST_STRICT=true
MAX_FILE_MB=10
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
SIM_INTERVAL_S=4
AUTO_QUEUE_REASONING=false
